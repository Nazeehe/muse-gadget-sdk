# Muse apps (small Lua programs), loaded after the board's own overlay:
#   MUSE_APPS=1 tools/muse/board.sh build|flash s3
# For the Waveshare S3 1.75C: the launcher hangs off the pocket watch
# (CONFIG_MUSE_CLOCK), which the other boards' overlays don't turn on, and
# without it Kconfig drops this option.
CONFIG_MUSE_APPS=y
