# Muse apps (small Lua programs), loaded after the board's own overlay:
#   MUSE_APPS=1 tools/muse/board.sh build|flash s3
# Only for the Waveshare S3 1.75C, and board.sh refuses MUSE_APPS=1 for any
# other board: the launcher hangs off the pocket watch (CONFIG_MUSE_CLOCK),
# which only its overlay turns on, and while Kconfig drops this option without
# it, the partition table and the FAT lines below would still apply.
CONFIG_MUSE_APPS=y

# The apps' storage: partitions_muse.csv plus the FAT for the apps and their own
# NVS (apps_nvs). Writing it takes a USB flash; a build dir made before this line
# keeps the table in its own sdkconfig until both PARTITION_TABLE_*FILENAME lines
# there say partitions_muse_apps.csv.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_muse_apps.csv"
# Long file names on the FAT, their buffers on the heap and in PSRAM: ids like
# stopwatch and paths like timer_face.lua aren't 8.3 names.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_ALLOC_PREFER_EXTRAM=y

# app.control's snapshot draws the screen with LVGL's snapshot (apps_snapshot.c);
# the bench overlay has it for the USB screenshots, which this brings to an apps
# build too.
CONFIG_LV_USE_SNAPSHOT=y
